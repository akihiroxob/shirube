PORT=51740
SHIRUBE_DB_PATH=.tmp/shirube.db

# Manager Runner
SHIRUBE_URL=http://localhost:51740

# Generic Runner identity. MANAGER_RUNNER_ID remains supported for compatibility.
SHIRUBE_RUNNER_ID=manager-runner-local
# Optional Bearer token sent by the Runner. When Shirube is exposed outside a
# trusted network, configure the ingress/proxy in front of Shirube to validate
# this same secret. Shirube does not yet own first-class Runner credentials.
SHIRUBE_RUNNER_TOKEN=
# Generic polling / lease settings. MANAGER_* variants remain supported.
SHIRUBE_RUNNER_POLL_MS=2000
SHIRUBE_RUNNER_LEASE_SECONDS=900

# Backward-compatible names
# MANAGER_RUNNER_ID=manager-runner-local
# MANAGER_POLL_MS=2000
# MANAGER_LEASE_SECONDS=900

# Example:
# MANAGER_COMMAND=codex exec "Read SHIRUBE_MANAGER_WORK_ID and handle the requested Shirube manager work."
MANAGER_COMMAND=
